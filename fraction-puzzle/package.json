{
  "name": "fraction-puzzle",
  "version": "1.0.0",
  "private": true,
  "description": "만 10세용 분수·소수 퍼즐 (정적 PWA)",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:all": "npm test && npm run test:e2e",
    "icons": "node tools/make-icons.mjs",
    "screenshots": "node tools/screenshots.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
