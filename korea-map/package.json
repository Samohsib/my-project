{
  "name": "korea-map",
  "version": "1.0.0",
  "private": true,
  "description": "우리나라 지도 탐험 — 만 10세 어린이용 지도 놀이 (정적 사이트, 빌드 없음)",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "playwright test",
    "build:geo": "node tools/build-geo.mjs",
    "build:icons": "node tools/make-icons.mjs",
    "screenshots": "node tools/screenshots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "admdongkor": "0.5.2",
    "mapshaper": "0.7.101"
  }
}
